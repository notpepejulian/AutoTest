---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout
  title="Nosotros - AutoTest"
  description="Conoce más sobre AutoTest, tu plataforma de preparación para el examen de autoescuela"
>
  <div class="max-w-4xl mx-auto px-6">
    <!-- Hero Section -->
    <section class="text-center py-20 mb-16">
      <div
        class="inline-flex items-center px-4 py-2 rounded-xl bg-gray-50 dark:bg-gray-900 border border-gray-100 dark:border-gray-800 text-gray-500 dark:text-gray-400 text-[10px] font-black uppercase tracking-widest mb-8"
      >
        <svg
          class="w-3 h-3 mr-2"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2.5"
            d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"
          ></path>
        </svg>
        Identidad Corporativa
      </div>

      <h1
        class="text-5xl lg:text-7xl font-black mb-8 tracking-tighter text-gray-900 dark:text-white uppercase"
      >
        Vanguardia en <br />
        <span class="text-blue-600">Formación Vial</span>
      </h1>
      <p
        class="text-lg font-medium text-gray-500 dark:text-gray-400 mb-12 max-w-2xl mx-auto leading-relaxed"
      >
        Comprometidos con la excelencia técnica, ofrecemos la plataforma de
        evaluación más robusta y adaptativa del sector.
      </p>
    </section>

    <!-- Main Content -->
    <div class="space-y-24">
      <!-- Mission Section -->
      <section
        class="bg-gray-50 dark:bg-gray-900 rounded-[2.5rem] p-10 lg:p-16 border border-gray-100 dark:border-gray-800 relative overflow-hidden"
      >
        <div
          class="absolute top-0 right-0 w-64 h-64 bg-blue-500/5 blur-[100px] rounded-full"
        >
        </div>
        <div class="flex flex-col lg:flex-row gap-12 items-center">
          <div
            class="w-20 h-20 bg-gray-900 dark:bg-white rounded-3xl flex items-center justify-center flex-shrink-0 shadow-2xl"
          >
            <svg
              class="w-8 h-8 text-white dark:text-gray-900"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2.5"
                d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <div>
            <h2
              class="text-3xl font-black mb-6 text-gray-900 dark:text-white uppercase tracking-tight"
            >
              Nuestra Misión
            </h2>
            <p
              class="text-gray-500 dark:text-gray-400 font-medium leading-relaxed mb-6"
            >
              En <strong class="text-gray-900 dark:text-white">AutoTest</strong
              >, transformamos la preparación teórica en una experiencia de alto
              rendimiento. Nuestra misión es dotar al aspirante de herramientas
              analíticas que garanticen no solo el aprobado, sino una
              comprensión profunda de la seguridad vial.
            </p>
            <p
              class="text-gray-500 dark:text-gray-400 font-medium leading-relaxed"
            >
              Desarrollamos algoritmos de evaluación que simulan con precisión
              milimétrica las condiciones del examen oficial, proporcionando una
              métrica real de capacidades.
            </p>
          </div>
        </div>
      </section>

      <!-- What We Offer Section -->
      <section>
        <div class="text-center mb-16">
          <h2
            class="text-xs font-black text-blue-500 uppercase tracking-[0.3em] mb-4"
          >
            Servicios Core
          </h2>
          <p
            class="text-3xl font-black text-gray-900 dark:text-white tracking-tighter uppercase"
          >
            Capacidades del Ecosistema
          </p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          <div
            class="group p-8 bg-white dark:bg-gray-900 rounded-3xl border border-gray-100 dark:border-gray-800 hover:border-blue-500/30 transition-all duration-500 shadow-sm hover:shadow-xl hover:shadow-blue-500/5"
          >
            <div
              class="w-12 h-12 bg-gray-50 dark:bg-gray-800 rounded-2xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform"
            >
              <svg
                class="w-6 h-6 text-blue-600"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"
                ></path></svg
              >
            </div>
            <h3
              class="text-lg font-black mb-3 text-gray-900 dark:text-white uppercase tracking-tight"
            >
              Evaluación Técnica
            </h3>
            <p
              class="text-sm font-medium text-gray-500 dark:text-gray-400 leading-relaxed"
            >
              Bancos de preguntas segmentados por normativa, señalización y
              mecánica avanzada.
            </p>
          </div>

          <div
            class="group p-8 bg-white dark:bg-gray-900 rounded-3xl border border-gray-100 dark:border-gray-800 hover:border-blue-500/30 transition-all duration-500 shadow-sm hover:shadow-xl hover:shadow-blue-500/5"
          >
            <div
              class="w-12 h-12 bg-gray-50 dark:bg-gray-800 rounded-2xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform"
            >
              <svg
                class="w-6 h-6 text-blue-600"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg
              >
            </div>
            <h3
              class="text-lg font-black mb-3 text-gray-900 dark:text-white uppercase tracking-tight"
            >
              Simulación Real
            </h3>
            <p
              class="text-sm font-medium text-gray-500 dark:text-gray-400 leading-relaxed"
            >
              Entornos temporizados bajo protocolos oficiales para mitigar el
              factor estrés.
            </p>
          </div>

          <div
            class="group p-8 bg-white dark:bg-gray-900 rounded-3xl border border-gray-100 dark:border-gray-800 hover:border-blue-500/30 transition-all duration-500 shadow-sm hover:shadow-xl hover:shadow-blue-500/5"
          >
            <div
              class="w-12 h-12 bg-gray-50 dark:bg-gray-800 rounded-2xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform"
            >
              <svg
                class="w-6 h-6 text-blue-600"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2"
                ></path></svg
              >
            </div>
            <h3
              class="text-lg font-black mb-3 text-gray-900 dark:text-white uppercase tracking-tight"
            >
              Data Analytics
            </h3>
            <p
              class="text-sm font-medium text-gray-500 dark:text-gray-400 leading-relaxed"
            >
              Desglose detallado de rendimiento para identificación de áreas
              críticas de mejora.
            </p>
          </div>
        </div>
      </section>

      <!-- Stats Section -->
      <section
        class="bg-gray-900 dark:bg-white rounded-[3rem] p-12 lg:p-20 text-center relative overflow-hidden shadow-2xl"
      >
        <div class="absolute inset-0 bg-blue-600/10 pointer-events-none"></div>
        <div class="relative z-10 grid md:grid-cols-3 gap-12 lg:gap-24">
          <div>
            <div
              class="text-5xl lg:text-7xl font-black text-white dark:text-gray-900 mb-4 tracking-tighter"
            >
              500+
            </div>
            <div
              class="text-[10px] font-bold text-gray-400 dark:text-gray-500 uppercase tracking-[0.2em]"
            >
              Bases de Datos
            </div>
          </div>
          <div>
            <div
              class="text-5xl lg:text-7xl font-black text-white dark:text-gray-900 mb-4 tracking-tighter"
            >
              95%
            </div>
            <div
              class="text-[10px] font-bold text-gray-400 dark:text-gray-500 uppercase tracking-[0.2em]"
            >
              Índice de Aprobación
            </div>
          </div>
          <div>
            <div
              class="text-5xl lg:text-7xl font-black text-white dark:text-gray-900 mb-4 tracking-tighter"
            >
              24/7
            </div>
            <div
              class="text-[10px] font-bold text-gray-400 dark:text-gray-500 uppercase tracking-[0.2em]"
            >
              Disponibilidad Red
            </div>
          </div>
        </div>
      </section>

      <!-- Technology Section -->
      <section
        class="bg-white dark:bg-gray-950 rounded-[2.5rem] p-10 lg:p-16 border border-gray-100 dark:border-gray-800 shadow-sm"
      >
        <div class="flex flex-col lg:flex-row gap-12">
          <div
            class="w-16 h-16 bg-blue-100 dark:bg-blue-900/30 rounded-2xl flex items-center justify-center flex-shrink-0"
          >
            <svg
              class="w-8 h-8 text-blue-600"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2.5"
                d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg
            >
          </div>
          <div class="flex-1">
            <h2
              class="text-3xl font-black mb-6 text-gray-900 dark:text-white uppercase tracking-tight"
            >
              Infraestructura Tecnológica
            </h2>
            <p
              class="text-gray-500 dark:text-gray-400 font-medium leading-relaxed mb-10"
            >
              Arquitectura basada en microservicios diseñada para ofrecer
              latencia cero y máxima integridad de datos en entornos
              concurrentes.
            </p>
            <div class="grid sm:grid-cols-2 gap-8">
              <div class="flex items-start space-x-4">
                <div class="w-2 h-2 rounded-full bg-blue-500 mt-2"></div>
                <div>
                  <h4
                    class="text-xs font-black text-gray-900 dark:text-white uppercase tracking-widest mb-1"
                  >
                    Capa de Usuario
                  </h4>
                  <p class="text-xs text-gray-500 font-bold">
                    Astro & Tailwind CSS
                  </p>
                </div>
              </div>
              <div class="flex items-start space-x-4">
                <div class="w-2 h-2 rounded-full bg-blue-500 mt-2"></div>
                <div>
                  <h4
                    class="text-xs font-black text-gray-900 dark:text-white uppercase tracking-widest mb-1"
                  >
                    Engine de Datos
                  </h4>
                  <p class="text-xs text-gray-500 font-bold">
                    FastAPI & PostgreSQL
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Future Section -->
      <section class="text-center pb-20">
        <h2
          class="text-4xl lg:text-5xl font-black mb-8 text-gray-900 dark:text-white uppercase tracking-tighter"
        >
          Hoja de Ruta
        </h2>
        <p
          class="text-lg font-medium text-gray-500 dark:text-gray-400 mb-12 max-w-2xl mx-auto leading-relaxed"
        >
          Evolucionamos hacia la integración de modelos predictivos
          personalizados y simuladores inmersivos de conducción técnica.
        </p>

        <div class="flex flex-wrap justify-center gap-4">
          <a
            href="/tests/"
            class="px-10 py-5 bg-gray-900 dark:bg-white text-white dark:text-gray-900 rounded-2xl hover:scale-105 transition-all font-black text-xs uppercase tracking-[0.2em] shadow-xl"
          >
            Iniciar Evaluación
          </a>
          <a
            href="/chatbot/"
            class="px-10 py-5 bg-white dark:bg-gray-900 text-gray-900 dark:text-white border border-gray-100 dark:border-gray-800 rounded-2xl hover:bg-gray-50 dark:hover:bg-gray-800 transition-all font-black text-xs uppercase tracking-[0.2em]"
          >
            Soporte Neural
          </a>
        </div>
      </section>
    </div>
  </div>
</MainLayout>

<style>
  /* Smooth scroll behavior */
  html {
    scroll-behavior: smooth;
  }
</style>
