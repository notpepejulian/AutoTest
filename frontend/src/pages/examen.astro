<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Exámenes Disponibles</title>
    <link rel="stylesheet" href="/styles.css"> <!-- Asegúrate de tener un archivo de estilos -->
</head>
<body>
    <section class="container mx-auto px-4 py-8">
        <h1 class="text-4xl font-bold text-center mb-8">Exámenes Disponibles</h1>
        
        <div id="exams-container" class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
            <!-- Aquí se cargarán las tarjetas de exámenes -->
        </div>
    </section>

    <script>
        document.addEventListener('DOMContentLoaded', async () => {
            const examsContainer = document.getElementById('exams-container');
            const response = await fetch('/api/examenes');
            const exams = await response.json();

            exams.forEach(exam => {
                const examCard = document.createElement('div');
                examCard.className = 'card rounded-xl shadow-lg p-4';
                examCard.innerHTML = `
                    <h2 class="text-2xl font-semibold">${exam.nombre}</h2>
                    <p>${exam.descripcion}</p>
                    <p>Duración: ${exam.duracion} minutos</p>
                    <p>Número de preguntas: ${exam.numero_preguntas}</p>
                    <a href="/examen/${exam.id}" class="btn">Iniciar Examen</a>
                `;
                examsContainer.appendChild(examCard);
            });
        });
    </script>
</body>
</html>
