---
import MainLayout from "../layouts/MainLayout.astro";

// Redirigir si ya está autenticado (SSR)
const token = Astro.cookies.get("access_token")?.value;
if (token) {
    return Astro.redirect("/tests");
}
---

<MainLayout
    title="Acceso de Usuario - AutoTest"
    description="Portal de autenticación técnica para la plataforma de formación vial."
>
    <div class="min-h-[85vh] flex items-center justify-center py-16 px-6">
        <div class="max-w-md w-full relative">
            <!-- Background Glow -->
            <div
                class="absolute -inset-10 bg-gradient-to-br from-blue-500/10 to-indigo-500/10 rounded-[4rem] blur-3xl opacity-50 -z-10"
            >
            </div>

            <!-- Header -->
            <div class="text-center mb-12">
                <div
                    class="inline-flex items-center justify-center w-20 h-20 rounded-3xl bg-gray-900 dark:bg-white mb-8 shadow-2xl transform hover:rotate-6 transition-transform"
                >
                    <svg
                        class="w-10 h-10 text-white dark:text-gray-900"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2.5"
                            d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"
                        ></path>
                    </svg>
                </div>
                <h2
                    class="text-4xl font-black text-gray-900 dark:text-white uppercase tracking-tighter mb-4"
                >
                    Sincronización <span class="text-blue-600">Total</span>
                </h2>
                <p class="text-sm font-medium text-gray-500 dark:text-gray-400">
                    Autenticación segura para el acceso a métricas de
                    rendimiento y trazabilidad de objetivos.
                </p>
            </div>

            <!-- Tab Switcher -->
            <div
                class="flex p-1.5 bg-gray-100 dark:bg-gray-800 rounded-2xl mb-8"
            >
                <button
                    id="loginTab"
                    class="flex-1 py-3 text-xs font-black uppercase tracking-widest rounded-xl transition-all duration-300 bg-white dark:bg-gray-700 text-blue-600 dark:text-blue-400 shadow-md"
                >
                    Acceso
                </button>
                <button
                    id="registerTab"
                    class="flex-1 py-3 text-xs font-black uppercase tracking-widest rounded-xl transition-all duration-300 text-gray-500 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-200"
                >
                    Registro
                </button>
            </div>

            <div
                class="bg-white dark:bg-gray-900 rounded-[2.5rem] shadow-2xl border border-gray-100 dark:border-gray-800 overflow-hidden transition-all"
            >
                <!-- Login Form -->
                <div id="loginForm" class="p-10 lg:p-12">
                    <form id="loginFormElement" class="space-y-8">
                        <div>
                            <label
                                for="login-username"
                                class="block text-[10px] font-black uppercase tracking-[0.2em] text-gray-400 mb-3"
                                >Identificador</label
                            >
                            <input
                                type="text"
                                id="login-username"
                                name="username"
                                required
                                class="block w-full px-6 py-4 bg-gray-50 dark:bg-gray-800 border-none rounded-2xl text-gray-900 dark:text-white focus:ring-4 focus:ring-blue-500/10 transition-all font-semibold placeholder-gray-400"
                                placeholder="Nombre de usuario"
                            />
                        </div>

                        <div>
                            <label
                                for="login-password"
                                class="block text-[10px] font-black uppercase tracking-[0.2em] text-gray-400 mb-3"
                                >Clave de Acceso</label
                            >
                            <input
                                type="password"
                                id="login-password"
                                name="password"
                                required
                                class="block w-full px-6 py-4 bg-gray-50 dark:bg-gray-800 border-none rounded-2xl text-gray-900 dark:text-white focus:ring-4 focus:ring-blue-500/10 transition-all font-semibold placeholder-gray-400"
                                placeholder="••••••••"
                            />
                        </div>

                        <div
                            id="loginError"
                            class="hidden p-4 rounded-2xl bg-red-50 dark:bg-red-900/20 text-red-600 dark:text-red-400 text-xs font-bold border border-red-100 dark:border-red-900/40"
                        >
                        </div>

                        <button
                            type="submit"
                            class="w-full flex justify-center py-5 px-4 bg-blue-600 hover:bg-blue-700 text-white rounded-2xl shadow-xl shadow-blue-600/20 font-black text-xs uppercase tracking-[0.2em] transition-all transform active:scale-95"
                        >
                            <span id="loginButtonText">Validar Identidad</span>
                            <span id="loginButtonLoading" class="hidden"
                                >Verificando...</span
                            >
                        </button>
                    </form>
                </div>

                <!-- Register Form -->
                <div id="registerForm" class="hidden p-10 lg:p-12">
                    <form id="registerFormElement" class="space-y-6">
                        <div>
                            <label
                                for="register-email"
                                class="block text-[10px] font-black uppercase tracking-[0.2em] text-gray-400 mb-3"
                                >Comunicación</label
                            >
                            <input
                                type="email"
                                id="register-email"
                                name="email"
                                required
                                class="block w-full px-6 py-4 bg-gray-50 dark:bg-gray-800 border-none rounded-2xl text-gray-900 dark:text-white focus:ring-4 focus:ring-blue-500/10 transition-all font-semibold placeholder-gray-400"
                                placeholder="Correo institucional"
                            />
                        </div>

                        <div>
                            <label
                                for="register-username"
                                class="block text-[10px] font-black uppercase tracking-[0.2em] text-gray-400 mb-3"
                                >Nuevo ID</label
                            >
                            <input
                                type="text"
                                id="register-username"
                                name="username"
                                required
                                minlength="3"
                                class="block w-full px-6 py-4 bg-gray-50 dark:bg-gray-800 border-none rounded-2xl text-gray-900 dark:text-white focus:ring-4 focus:ring-blue-500/10 transition-all font-semibold placeholder-gray-400"
                                placeholder="Mínimo 3 caracteres"
                            />
                        </div>

                        <div>
                            <label
                                for="register-password"
                                class="block text-[10px] font-black uppercase tracking-[0.2em] text-gray-400 mb-3"
                                >Seguridad</label
                            >
                            <input
                                type="password"
                                id="register-password"
                                name="password"
                                required
                                minlength="6"
                                class="block w-full px-6 py-4 bg-gray-50 dark:bg-gray-800 border-none rounded-2xl text-gray-900 dark:text-white focus:ring-4 focus:ring-blue-500/10 transition-all font-semibold placeholder-gray-400"
                                placeholder="Mínimo 6 caracteres"
                            />
                        </div>

                        <div
                            id="registerError"
                            class="hidden p-4 rounded-2xl bg-red-50 dark:bg-red-900/20 text-red-600 dark:text-red-400 text-xs font-bold border border-red-100 dark:border-red-900/40"
                        >
                        </div>
                        <div
                            id="registerSuccess"
                            class="hidden p-4 rounded-2xl bg-green-50 dark:bg-green-900/20 text-green-600 dark:text-green-400 text-xs font-bold border border-green-100 dark:border-green-900/40"
                        >
                        </div>

                        <button
                            type="submit"
                            class="w-full flex justify-center py-5 px-4 bg-blue-600 hover:bg-blue-700 text-white rounded-2xl shadow-xl shadow-blue-600/20 font-black text-xs uppercase tracking-[0.2em] transition-all transform active:scale-95"
                        >
                            <span id="registerButtonText">Formalizar Alta</span>
                            <span id="registerButtonLoading" class="hidden"
                                >Procesando...</span
                            >
                        </button>
                    </form>
                </div>
            </div>

            <!-- Footer Note -->
            <p
                class="text-center text-[10px] font-bold text-gray-400 uppercase tracking-widest mt-12 bg-gray-50 dark:bg-gray-800/50 py-3 rounded-full border border-gray-100 dark:border-gray-800"
            >
                Protocolos de Privacidad Neuralmente Asegurados
            </p>
        </div>
    </div>
</MainLayout>

<script>
    const loginTab = document.getElementById("loginTab")!;
    const registerTab = document.getElementById("registerTab")!;
    const loginForm = document.getElementById("loginForm")!;
    const registerForm = document.getElementById("registerForm")!;
    const loginFormElement = document.getElementById(
        "loginFormElement",
    ) as HTMLFormElement;
    const registerFormElement = document.getElementById(
        "registerFormElement",
    ) as HTMLFormElement;

    function showLogin() {
        loginTab.className =
            "flex-1 py-3 text-xs font-black uppercase tracking-widest rounded-xl transition-all duration-300 bg-white dark:bg-gray-700 text-blue-600 dark:text-blue-400 shadow-md";
        registerTab.className =
            "flex-1 py-3 text-xs font-black uppercase tracking-widest rounded-xl transition-all duration-300 text-gray-500 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-200";
        loginForm.classList.remove("hidden");
        registerForm.classList.add("hidden");
    }

    function showRegister() {
        registerTab.className =
            "flex-1 py-3 text-xs font-black uppercase tracking-widest rounded-xl transition-all duration-300 bg-white dark:bg-gray-700 text-blue-600 dark:text-blue-400 shadow-md";
        loginTab.className =
            "flex-1 py-3 text-xs font-black uppercase tracking-widest rounded-xl transition-all duration-300 text-gray-500 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-200";
        registerForm.classList.remove("hidden");
        loginForm.classList.add("hidden");
    }

    loginTab.addEventListener("click", showLogin);
    registerTab.addEventListener("click", showRegister);

    loginFormElement.addEventListener("submit", async (e) => {
        e.preventDefault();
        const errorDiv = document.getElementById("loginError")!;
        const btnText = document.getElementById("loginButtonText")!;
        const btnLoading = document.getElementById("loginButtonLoading")!;

        errorDiv.classList.add("hidden");
        btnText.classList.add("hidden");
        btnLoading.classList.remove("hidden");

        try {
            const formData = new FormData(loginFormElement);
            const response = await fetch("/api/proxy/auth/login", {
                method: "POST",
                body: formData,
            });

            const data = await response.json();
            if (!response.ok)
                throw new Error(data.detail || "Fallo en la autenticación");
            window.location.href = "/tests";
        } catch (err: any) {
            errorDiv.textContent = err.message;
            errorDiv.classList.remove("hidden");
        } finally {
            btnText.classList.remove("hidden");
            btnLoading.classList.add("hidden");
        }
    });

    registerFormElement.addEventListener("submit", async (e) => {
        e.preventDefault();
        const errorDiv = document.getElementById("registerError")!;
        const successDiv = document.getElementById("registerSuccess")!;
        const btnText = document.getElementById("registerButtonText")!;
        const btnLoading = document.getElementById("registerButtonLoading")!;

        errorDiv.classList.add("hidden");
        successDiv.classList.add("hidden");
        btnText.classList.add("hidden");
        btnLoading.classList.remove("hidden");

        const formData = new FormData(registerFormElement);
        const data = Object.fromEntries(formData.entries());

        try {
            const response = await fetch("/api/proxy/auth/register", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify(data),
            });

            const result = await response.json();
            if (!response.ok)
                throw new Error(result.detail || "Fallo en el registro");

            successDiv.textContent = "Registro completado. Redirigiendo...";
            successDiv.classList.remove("hidden");
            setTimeout(() => {
                showLogin();
                registerFormElement.reset();
            }, 1500);
        } catch (err: any) {
            errorDiv.textContent = err.message;
            errorDiv.classList.remove("hidden");
        } finally {
            btnText.classList.remove("hidden");
            btnLoading.classList.add("hidden");
        }
    });
</script>
