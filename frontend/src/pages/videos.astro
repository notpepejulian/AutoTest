---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout
  title="Aula Virtual - AutoTest"
  description="Contenidos audiovisuales de alta fidelidad para la formación vial técnica."
>
  <div class="max-w-6xl mx-auto px-6">
    <!-- Hero Section -->
    <section class="text-center py-20 mb-12">
      <div
        class="inline-flex items-center px-4 py-1.5 rounded-xl bg-blue-50 dark:bg-blue-900/20 text-blue-600 dark:text-blue-400 text-[10px] font-black uppercase tracking-widest mb-8 border border-blue-100 dark:border-blue-800"
      >
        Centro de Formación Multimedia
      </div>
      <h1
        class="text-5xl lg:text-7xl font-black mb-8 tracking-tighter text-gray-900 dark:text-white uppercase"
      >
        Aprendizaje <span class="text-blue-600">Visual</span>
      </h1>
      <p
        class="text-lg font-medium text-gray-500 dark:text-gray-400 max-w-2xl mx-auto leading-relaxed"
      >
        Refuerzo técnico mediante contenidos audiovisuales especializados en
        normativa, señalización y seguridad vial avanzada.
      </p>
    </section>

    <!-- Videos Grid -->
    <section class="mb-24">
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        <!-- Video Placeholder 1 -->
        <div
          class="group bg-white dark:bg-gray-900 rounded-[2rem] border border-gray-100 dark:border-gray-800 overflow-hidden shadow-sm hover:shadow-2xl hover:shadow-blue-500/5 transition-all duration-500"
        >
          <div
            class="aspect-video bg-gray-50 dark:bg-gray-800 flex items-center justify-center relative overflow-hidden"
          >
            <div
              class="absolute inset-0 bg-gradient-to-br from-blue-500/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"
            >
            </div>
            <div class="text-center relative z-10">
              <div
                class="w-16 h-16 mx-auto mb-4 bg-white dark:bg-gray-700 rounded-2xl flex items-center justify-center shadow-lg transform group-hover:scale-110 transition-transform"
              >
                <svg
                  class="w-8 h-8 text-blue-500"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2.5"
                    d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"
                  ></path>
                </svg>
              </div>
              <p
                class="text-[10px] font-black text-gray-400 uppercase tracking-widest"
              >
                Contenido en Proceso
              </p>
            </div>
          </div>
          <div class="p-8">
            <h3
              class="text-lg font-black mb-2 text-gray-900 dark:text-white uppercase tracking-tight"
            >
              Sistemas de Señalización
            </h3>
            <p
              class="text-sm font-medium text-gray-500 dark:text-gray-400 leading-relaxed"
            >
              Análisis técnico de la jerarquía y tipología de señales oficiales.
            </p>
          </div>
        </div>

        <!-- Video Placeholder 2 -->
        <div
          class="group bg-white dark:bg-gray-900 rounded-[2rem] border border-gray-100 dark:border-gray-800 overflow-hidden shadow-sm hover:shadow-2xl hover:shadow-blue-500/5 transition-all duration-500"
        >
          <div
            class="aspect-video bg-gray-50 dark:bg-gray-800 flex items-center justify-center relative overflow-hidden"
          >
            <div class="text-center relative z-10">
              <div
                class="w-16 h-16 mx-auto mb-4 bg-white dark:bg-gray-700 rounded-2xl flex items-center justify-center shadow-lg transform group-hover:scale-110 transition-transform"
              >
                <svg
                  class="w-8 h-8 text-green-500"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2.5"
                    d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"
                  ></path>
                </svg>
              </div>
              <p
                class="text-[10px] font-black text-gray-400 uppercase tracking-widest"
              >
                Próxima Publicación
              </p>
            </div>
          </div>
          <div class="p-8">
            <h3
              class="text-lg font-black mb-2 text-gray-900 dark:text-white uppercase tracking-tight"
            >
              Protocolos de Prioridad
            </h3>
            <p
              class="text-sm font-medium text-gray-500 dark:text-gray-400 leading-relaxed"
            >
              Normativa avanzada sobre intersecciones y preferencias dinámicas.
            </p>
          </div>
        </div>

        <!-- Video Placeholder 3 -->
        <div
          class="group bg-white dark:bg-gray-900 rounded-[2rem] border border-gray-100 dark:border-gray-800 overflow-hidden shadow-sm hover:shadow-2xl hover:shadow-blue-500/5 transition-all duration-500"
        >
          <div
            class="aspect-video bg-gray-50 dark:bg-gray-800 flex items-center justify-center relative overflow-hidden"
          >
            <div class="text-center relative z-10">
              <div
                class="w-16 h-16 mx-auto mb-4 bg-white dark:bg-gray-700 rounded-2xl flex items-center justify-center shadow-lg transform group-hover:scale-110 transition-transform"
              >
                <svg
                  class="w-8 h-8 text-purple-500"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2.5"
                    d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"
                  ></path>
                </svg>
              </div>
              <p
                class="text-[10px] font-black text-gray-400 uppercase tracking-widest"
              >
                En Edición
              </p>
            </div>
          </div>
          <div class="p-8">
            <h3
              class="text-lg font-black mb-2 text-gray-900 dark:text-white uppercase tracking-tight"
            >
              Seguridad Pasiva
            </h3>
            <p
              class="text-sm font-medium text-gray-500 dark:text-gray-400 leading-relaxed"
            >
              Fundamentos de protección y mitigación de riesgos en ruta.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Instructions Section -->
    <section class="max-w-4xl mx-auto pb-20">
      <div
        class="bg-gray-900 dark:bg-white rounded-[3rem] p-12 lg:p-16 text-center shadow-2xl relative overflow-hidden"
      >
        <div class="absolute inset-0 bg-blue-600/5 pointer-events-none"></div>
        <div class="relative z-10">
          <h2
            class="text-3xl font-black mb-6 text-white dark:text-gray-900 uppercase tracking-tight"
          >
            Estructura Modular en Desarrollo
          </h2>
          <p
            class="text-lg font-medium text-gray-400 dark:text-gray-500 max-w-2xl mx-auto leading-relaxed mb-10"
          >
            Estamos integrando una infraestructura de streaming para ofrecer
            tutoriales interactivos. Próximamente dispondrá de una biblioteca
            completa sincronizada con el temario oficial.
          </p>
          <div
            class="inline-flex items-center space-x-2 px-6 py-2 rounded-full border border-gray-800 dark:border-gray-200"
          >
            <span class="w-2 h-2 bg-blue-500 rounded-full animate-pulse"></span>
            <span
              class="text-[10px] font-bold text-gray-500 uppercase tracking-widest"
              >Sincronización de medios Activa</span
            >
          </div>
        </div>
      </div>
    </section>
  </div>
</MainLayout>
