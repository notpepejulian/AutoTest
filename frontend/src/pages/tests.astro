---
import MainLayout from "../layouts/MainLayout.astro";

// SSR Auth Check (Opcional para esta página, pero útil para personalizar)
const token = Astro.cookies.get("access_token")?.value;
---

<MainLayout
  title="Seleccionar Test - AutoTest"
  description="Elige tu categoría de test para comenzar tu preparación"
>
  <div class="max-w-6xl mx-auto px-4">
    <!-- Hero Section -->
    <section class="text-center py-12 lg:py-20 mb-8">
      <div
        class="inline-flex items-center px-4 py-1.5 rounded-full bg-blue-50 dark:bg-blue-900/20 text-blue-700 dark:text-blue-400 text-xs font-bold uppercase tracking-wider mb-8 border border-blue-100 dark:border-blue-800"
      >
        Exámenes de Formación Vial
      </div>

      <h1
        class="text-4xl lg:text-6xl font-black mb-6 text-gray-900 dark:text-white leading-tight"
      >
        Catálogo de <span class="text-blue-600">Tests</span>
      </h1>
      <p
        class="text-lg text-gray-600 dark:text-gray-400 mb-8 max-w-2xl mx-auto leading-relaxed"
      >
        Accede a nuestra base de datos de preguntas oficiales y simulacros
        realistas diseñados para garantizar tu aprobado.
      </p>
    </section>

    <!-- Loading spinner -->
    <div id="loading" class="text-center py-20">
      <div class="inline-flex items-center space-x-2 text-blue-600">
        <svg class="w-6 h-6 animate-spin" viewBox="0 0 24 24">
          <circle
            class="opacity-25"
            cx="12"
            cy="12"
            r="10"
            stroke="currentColor"
            stroke-width="4"
            fill="none"></circle>
          <path
            class="opacity-75"
            fill="currentColor"
            d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
          ></path>
        </svg>
        <span class="font-semibold">Sincronizando contenidos...</span>
      </div>
    </div>

    <!-- Categories Grid -->
    <section id="categories-container" class="hidden">
      <div
        id="categories-grid"
        class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8"
      >
        <!-- Categories will be loaded here -->
      </div>
    </section>

    <!-- Tests Grid -->
    <section id="tests-container" class="hidden">
      <div class="mb-12">
        <button
          id="back-to-categories"
          class="hidden group inline-flex items-center space-x-2 px-5 py-2.5 bg-white dark:bg-gray-800 text-gray-700 dark:text-gray-300 rounded-xl border border-gray-200 dark:border-gray-700 hover:border-blue-500 dark:hover:border-blue-500 transition-all font-semibold text-sm"
        >
          <svg
            class="w-4 h-4 group-hover:-translate-x-1 transition-transform"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
          </svg>
          <span>Volver al Catálogo</span>
        </button>
        <div
          class="flex flex-col md:flex-row md:items-end justify-between mt-8 gap-4"
        >
          <div>
            <h2
              id="category-title"
              class="text-3xl font-bold text-gray-900 dark:text-white"
            >
            </h2>
            <p
              id="category-description"
              class="text-gray-600 dark:text-gray-400 mt-2 max-w-xl"
            >
            </p>
          </div>
          <div
            class="text-xs font-bold text-gray-400 uppercase tracking-widest"
            id="pagination-info"
          >
          </div>
        </div>
      </div>

      <div
        id="tests-grid"
        class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6"
      >
        <!-- Tests load here -->
      </div>

      <!-- Pagination -->
      <div
        id="pagination-controls"
        class="flex justify-center items-center space-x-2 mt-12 pb-12"
      >
        <button
          id="prev-page"
          class="p-2.5 bg-white dark:bg-gray-800 text-gray-500 rounded-lg border border-gray-200 dark:border-gray-700 hover:text-blue-600 disabled:opacity-30 transition-colors"
        >
          <svg
            class="w-5 h-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M15 19l-7-7 7-7"></path></svg
          >
        </button>
        <div id="page-numbers" class="flex items-center space-x-2"></div>
        <button
          id="next-page"
          class="p-2.5 bg-white dark:bg-gray-800 text-gray-500 rounded-lg border border-gray-200 dark:border-gray-700 hover:text-blue-600 disabled:opacity-30 transition-colors"
        >
          <svg
            class="w-5 h-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M9 5l7 7-7 7"></path></svg
          >
        </button>
      </div>
    </section>

    <!-- Professional Features -->
    <section class="mt-20 mb-20">
      <div class="grid md:grid-cols-3 gap-8">
        <div
          class="p-6 bg-white dark:bg-gray-800 rounded-2xl border border-gray-100 dark:border-gray-700 shadow-sm"
        >
          <div
            class="w-12 h-12 bg-blue-100 dark:bg-blue-900/30 text-blue-600 rounded-xl flex items-center justify-center mb-4"
          >
            <svg
              class="w-6 h-6"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg
            >
          </div>
          <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-2">
            Simulación Real
          </h3>
          <p class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed">
            Entorno de examen idéntico al oficial con gestión de tiempos
            profesional.
          </p>
        </div>
        <div
          class="p-6 bg-white dark:bg-gray-800 rounded-2xl border border-gray-100 dark:border-gray-700 shadow-sm"
        >
          <div
            class="w-12 h-12 bg-indigo-100 dark:bg-indigo-900/30 text-indigo-600 rounded-xl flex items-center justify-center mb-4"
          >
            <svg
              class="w-6 h-6"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"
              ></path></svg
            >
          </div>
          <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-2">
            Análisis de Datos
          </h3>
          <p class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed">
            Seguimiento detallado de aciertos y errores para optimizar tu
            estudio.
          </p>
        </div>
        <div
          class="p-6 bg-white dark:bg-gray-800 rounded-2xl border border-gray-100 dark:border-gray-700 shadow-sm"
        >
          <div
            class="w-12 h-12 bg-cyan-100 dark:bg-cyan-900/30 text-cyan-600 rounded-xl flex items-center justify-center mb-4"
          >
            <svg
              class="w-6 h-6"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
              ></path></svg
            >
          </div>
          <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-2">
            Actualización Diaria
          </h3>
          <p class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed">
            Nuestro banco de preguntas se actualiza según las últimas
            normativas.
          </p>
        </div>
      </div>
    </section>
  </div>

  <script>
    // Configuration
    const API_BASE = "/api/proxy";

    // DOM Elements
    const loading = document.getElementById("loading");
    const categoriesContainer = document.getElementById("categories-container");
    const testsContainer = document.getElementById("tests-container");
    const categoriesGrid = document.getElementById("categories-grid");
    const testsGrid = document.getElementById("tests-grid");
    const categoryTitle = document.getElementById("category-title");
    const categoryDescription = document.getElementById("category-description");
    const backToCategories = document.getElementById("back-to-categories");
    const paginationInfo = document.getElementById("pagination-info");
    const prevPageBtn = document.getElementById(
      "prev-page",
    ) as HTMLButtonElement;
    const nextPageBtn = document.getElementById(
      "next-page",
    ) as HTMLButtonElement;
    const pageNumbers = document.getElementById("page-numbers");

    // Current state
    let currentView = "categories";
    let selectedCategory = null;
    let currentPage = 1;
    let testsPerPage = 8;
    let totalTestsCount = 0;
    let currentTests = [];

    document.addEventListener("DOMContentLoaded", async () => {
      await loadCategories();
      setupEventListeners();
    });

    function setupEventListeners() {
      prevPageBtn?.addEventListener("click", () => {
        if (currentPage > 1) {
          currentPage--;
          renderCurrentPage();
          window.scrollTo({ top: 0, behavior: "smooth" });
        }
      });
      nextPageBtn?.addEventListener("click", () => {
        const totalPages = Math.ceil(totalTestsCount / testsPerPage);
        if (currentPage < totalPages) {
          currentPage++;
          renderCurrentPage();
          window.scrollTo({ top: 0, behavior: "smooth" });
        }
      });
    }

    async function loadCategories() {
      try {
        const response = await fetch(`${API_BASE}/categorias`);
        if (!response.ok) throw new Error("API Error");
        const categories = await response.json();

        // Find the mixed category or just use a default one
        const mixedCat =
          categories.find((c) => c.nombre.toLowerCase().includes("mixto")) ||
          categories[0];

        if (mixedCat) {
          showCategoryTests(mixedCat, {
            bg: "from-blue-600 to-blue-700",
            icon: "M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2",
          });
        }
      } catch (e) {
        console.error(e);
        showError();
      }
    }

    function showCategories() {
      loading?.classList.add("hidden");
      categoriesContainer?.classList.remove("hidden");
      testsContainer?.classList.add("hidden");
    }

    async function showCategoryTests(cat, style) {
      selectedCategory = { ...cat, style };
      categoryTitle!.textContent = cat.nombre;
      categoryDescription!.textContent = cat.descripcion;

      loading?.classList.remove("hidden");
      categoriesContainer?.classList.add("hidden");

      try {
        const response = await fetch(`${API_BASE}/examenes`);
        const tests = await response.json();
        currentTests = tests.filter(
          (t) =>
            t.categoria_principal_id === cat.id ||
            (cat.id === 5 && t.nombre.includes("Mixto")),
        );
        totalTestsCount = currentTests.length;
        currentPage = 1;
        renderCurrentPage();

        loading!.classList.add("hidden");
        testsContainer!.classList.remove("hidden");
      } catch (e) {
        console.error(e);
      }
    }

    function renderCurrentPage() {
      testsGrid!.innerHTML = "";
      const start = (currentPage - 1) * testsPerPage;
      const end = Math.min(start + testsPerPage, totalTestsCount);
      const totalPages = Math.ceil(totalTestsCount / testsPerPage);

      for (let i = start; i < end; i++) {
        const test = currentTests[i];
        const card = document.createElement("div");
        card.className =
          "group bg-white dark:bg-gray-800 p-6 rounded-2xl border border-gray-100 dark:border-gray-700 shadow-sm hover:shadow-md transition-all cursor-pointer";
        card.innerHTML = `
            <div class="flex items-center justify-between mb-4">
                <span class="text-xs font-black text-gray-300 dark:text-gray-600 uppercase tracking-tighter">Variante 0${i + 1}</span>
                <div class="w-2 h-2 rounded-full bg-blue-500"></div>
            </div>
            <h4 class="font-bold text-gray-900 dark:text-white mb-2">${test.nombre.replace(/Test\s*/i, "Test ")}</h4>
            <div class="flex items-center space-x-3 text-xs text-gray-400 font-semibold mb-6">
                <span class="flex items-center"><svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" stroke-width="3"/></svg>${test.num_preguntas} Preg.</span>
                <span class="flex items-center"><svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" stroke-width="3"/></svg>${test.duracion_minutos} Min.</span>
            </div>
            <button class="w-full py-2.5 rounded-xl bg-gray-50 dark:bg-gray-900 text-gray-900 dark:text-white text-xs font-bold border border-gray-100 dark:border-gray-700 group-hover:bg-blue-600 group-hover:text-white group-hover:border-blue-600 transition-all">COMENZAR EXAMEN</button>
        `;
        card.onclick = () => (window.location.href = `/examen/${test.id}/`);
        testsGrid!.appendChild(card);
      }

      paginationInfo!.textContent = `Muestreo ${start + 1}-${end} de ${totalTestsCount}`;
      updatePagination(totalPages);
    }

    function updatePagination(total) {
      prevPageBtn!.disabled = currentPage === 1;
      nextPageBtn!.disabled = currentPage === total;
      pageNumbers!.innerHTML = "";

      for (let i = 1; i <= total; i++) {
        const btn = document.createElement("button");
        btn.textContent = i.toString();
        btn.className = `w-8 h-8 rounded-lg text-xs font-bold transition-all ${currentPage === i ? "bg-blue-600 text-white" : "text-gray-400 hover:text-blue-600"}`;
        btn.onclick = () => {
          currentPage = i;
          renderCurrentPage();
          window.scrollTo({ top: 0, behavior: "smooth" });
        };
        pageNumbers!.appendChild(btn);
      }
    }

    function showError() {
      loading!.innerHTML = `<div class="p-8 text-center text-red-500 font-bold">Error de conexión con el servidor. Por favor, reintente más tarde.</div>`;
    }
  </script>
</MainLayout>
