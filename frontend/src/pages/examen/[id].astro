---
export const prerender = false;
import MainLayout from "../../layouts/MainLayout.astro";

const { id } = Astro.params;

if (!id || isNaN(Number(id))) {
  return Astro.redirect("/tests/");
}

const API_HOST = import.meta.env.BACKEND_API_URL || "http://backend:8000";

try {
  const response = await fetch(`${API_HOST}/api/examenes/${id}`);
  if (!response.ok) {
    return Astro.redirect("/tests/");
  }
} catch (error) {
  console.error(`Error checking exam ${id}:`, error);
  return Astro.redirect("/tests/");
}
---

<MainLayout
  title="Examen en Curso - AutoTest"
  description="Plataforma de evaluación profesional para conductores"
>
  <div class="max-w-4xl mx-auto px-4 py-8">
    <!-- Loading State -->
    <div id="loading" class="text-center py-20">
      <div class="inline-flex items-center space-x-3 text-blue-600">
        <svg class="w-8 h-8 animate-spin" viewBox="0 0 24 24">
          <circle
            class="opacity-25"
            cx="12"
            cy="12"
            r="10"
            stroke="currentColor"
            stroke-width="4"
            fill="none"></circle>
          <path
            class="opacity-75"
            fill="currentColor"
            d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
          ></path>
        </svg>
        <span class="text-xl font-bold tracking-tight"
          >Sincronizando banco de preguntas...</span
        >
      </div>
    </div>

    <!-- Test Header -->
    <div id="test-header" class="hidden mb-10">
      <div
        class="bg-white dark:bg-gray-800 rounded-2xl p-8 border border-gray-100 dark:border-gray-700 shadow-sm overflow-hidden relative"
      >
        <div class="absolute top-0 left-0 w-2 h-full bg-blue-600"></div>
        <div
          class="flex flex-col md:flex-row justify-between items-start md:items-center gap-6"
        >
          <div class="flex-1">
            <h1
              id="test-title"
              class="text-3xl font-black text-gray-900 dark:text-white mb-2 tracking-tight"
            >
              Cargando...
            </h1>
            <p
              id="test-description"
              class="text-gray-500 dark:text-gray-400 font-medium"
            >
            </p>
          </div>
          <div
            class="bg-gray-50 dark:bg-gray-900/50 px-6 py-4 rounded-2xl border border-gray-100 dark:border-gray-700 min-w-[140px] text-center"
          >
            <div
              id="timer"
              class="text-3xl font-mono font-bold text-gray-900 dark:text-white"
            >
              00:00
            </div>
            <div
              class="text-[10px] font-black text-gray-400 uppercase tracking-widest mt-1"
            >
              Tiempo Restante
            </div>
          </div>
        </div>

        <div class="mt-10">
          <div class="flex justify-between items-end mb-3">
            <span
              class="text-xs font-bold text-gray-400 uppercase tracking-widest"
              >Progreso de la Sesión</span
            >
            <span id="progress-text" class="text-sm font-black text-blue-600"
              >0%</span
            >
          </div>
          <div
            class="w-full bg-gray-100 dark:bg-gray-900 rounded-full h-1.5 overflow-hidden"
          >
            <div
              id="progress-bar"
              class="bg-blue-600 h-full transition-all duration-700 ease-out"
              style="width: 0%"
            >
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Question Interface -->
    <div id="question-container" class="hidden space-y-6">
      <div
        class="bg-white dark:bg-gray-800 rounded-3xl shadow-xl shadow-blue-500/5 border border-gray-100 dark:border-gray-700 overflow-hidden"
      >
        <div
          class="px-8 py-5 border-b border-gray-50 dark:border-gray-700 flex justify-between items-center bg-gray-50/30 dark:bg-gray-900/30"
        >
          <div class="flex items-center space-x-2">
            <span class="w-2 h-2 rounded-full bg-blue-500 animate-pulse"></span>
            <span
              class="text-xs font-black text-gray-500 uppercase tracking-wider"
              >Pregunta <span
                id="current-question-number"
                class="text-gray-900 dark:text-white">1</span
              > / <span id="total-questions">0</span></span
            >
          </div>
          <span
            class="text-[10px] font-bold text-gray-400 uppercase tracking-tighter"
            >ID REF: <span id="question-id"></span></span
          >
        </div>

        <div class="p-8 lg:p-12">
          <div
            id="question-text"
            class="text-2xl lg:text-3xl font-bold text-gray-900 dark:text-white mb-10 leading-tight tracking-tight"
          >
          </div>
          <div id="answer-options" class="grid gap-4"></div>
        </div>

        <div
          class="px-8 py-6 bg-gray-50 dark:bg-gray-900/50 border-t border-gray-50 dark:border-gray-700 flex flex-col sm:flex-row justify-between items-center gap-4"
        >
          <button
            id="prev-question"
            class="w-full sm:w-auto flex items-center justify-center space-x-2 px-8 py-3.5 text-gray-400 font-bold text-sm hover:text-blue-600 transition-colors disabled:opacity-0"
          >
            <svg
              class="w-5 h-5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2.5"
                d="M15 19l-7-7 7-7"></path></svg
            >
            <span>ANTERIOR</span>
          </button>

          <div class="flex w-full sm:w-auto space-x-3">
            <button
              id="next-question"
              class="flex-1 sm:flex-initial flex items-center justify-center space-x-2 px-10 py-3.5 bg-blue-600 text-white rounded-2xl hover:bg-blue-700 transition-all font-bold text-sm shadow-lg shadow-blue-600/20 active:scale-95"
            >
              <span>SIGUIENTE</span>
              <svg
                class="w-5 h-5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2.5"
                  d="M9 5l7 7-7 7"></path></svg
              >
            </button>

            <button
              id="finish-test"
              class="hidden flex-1 sm:flex-initial flex items-center justify-center space-x-2 px-10 py-3.5 bg-green-600 text-white rounded-2xl hover:bg-green-700 transition-all font-bold text-sm shadow-lg shadow-green-600/20 active:scale-95"
            >
              <span>CONCLUIR EVALUACIÓN</span>
              <svg
                class="w-5 h-5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2.5"
                  d="M5 13l4 4L19 7"></path></svg
              >
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Results Interface -->
    <div
      id="results-container"
      class="hidden animate-in fade-in zoom-in duration-500"
    >
      <div
        class="bg-white dark:bg-gray-800 rounded-3xl shadow-2xl border border-gray-100 dark:border-gray-700 overflow-hidden"
      >
        <div id="results-summary"></div>

        <div
          class="px-8 py-8 bg-gray-50 dark:bg-gray-900/50 flex flex-col sm:flex-row gap-4 justify-center border-t border-gray-50 dark:border-gray-700"
        >
          <button
            id="retry-test"
            class="group flex items-center justify-center space-x-3 px-10 py-4 bg-gray-900 dark:bg-white text-white dark:text-gray-900 rounded-2xl hover:scale-105 transition-all font-bold text-sm uppercase tracking-widest"
          >
            <svg
              class="w-5 h-5 group-hover:rotate-180 transition-transform duration-500"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2.5"
                d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
              ></path></svg
            >
            <span>Reiniciar</span>
          </button>

          <button
            id="back-to-tests"
            class="flex items-center justify-center space-x-3 px-10 py-4 text-gray-500 font-bold text-sm uppercase tracking-widest hover:text-blue-600 transition-colors"
          >
            <span>Catálogo Completo</span>
            <svg
              class="w-5 h-5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2.5"
                d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg
            >
          </button>
        </div>
      </div>
    </div>
  </div>

  <script define:vars={{ examId: id }}>
    const API_BASE = "/api/proxy";
    const EXAM_ID = examId;

    let currentExam = null;
    let questions = [];
    let currentQuestionIndex = 0;
    let answers = {};
    let startTime = null;
    let timerInterval = null;
    let timeLimit = 30 * 60;
    let timeRemaining = timeLimit;

    // DOM
    const loading = document.getElementById("loading");
    const testHeader = document.getElementById("test-header");
    const questionContainer = document.getElementById("question-container");
    const resultsContainer = document.getElementById("results-container");
    const testTitle = document.getElementById("test-title");
    const testDescription = document.getElementById("test-description");
    const timer = document.getElementById("timer");
    const progressBar = document.getElementById("progress-bar");
    const progressText = document.getElementById("progress-text");
    const currentQuestionNumber = document.getElementById(
      "current-question-number",
    );
    const totalQuestions = document.getElementById("total-questions");
    const questionIdSpan = document.getElementById("question-id");
    const questionTextContainer = document.getElementById("question-text");
    const answerOptionsContainer = document.getElementById("answer-options");
    const prevButton = document.getElementById("prev-question");
    const nextButton = document.getElementById("next-question");
    const finishButton = document.getElementById("finish-test");
    const resultsSummary = document.getElementById("results-summary");
    const retryButton = document.getElementById("retry-test");
    const backToTestsButton = document.getElementById("back-to-tests");

    document.addEventListener("DOMContentLoaded", async () => {
      await loadExam();
      setupListeners();
    });

    function setupListeners() {
      prevButton?.addEventListener("click", () => {
        if (currentQuestionIndex > 0) {
          currentQuestionIndex--;
          renderQuestion();
        }
      });
      nextButton?.addEventListener("click", () => {
        if (currentQuestionIndex < questions.length - 1) {
          currentQuestionIndex++;
          renderQuestion();
        }
      });
      finishButton?.addEventListener("click", concludeTest);
      retryButton?.addEventListener("click", () => window.location.reload());
      backToTestsButton?.addEventListener(
        "click",
        () => (window.location.href = "/tests/"),
      );
    }

    async function loadExam() {
      try {
        const res = await fetch(`${API_BASE}/examenes/${EXAM_ID}`);
        if (!res.ok) throw new Error("Exam not found");
        currentExam = await res.json();
        questions = currentExam.preguntas || [];

        testTitle.textContent = currentExam.nombre;
        testDescription.textContent =
          currentExam.descripcion ||
          "Evaluación técnica oficial de formación vial.";
        totalQuestions.textContent = questions.length;
        timeLimit = (currentExam.duracion_minutos || 30) * 60;
        timeRemaining = timeLimit;

        initSession();
      } catch (e) {
        console.error(e);
        showError("Ocurrió un fallo en la recuperación de datos.");
      }
    }

    function initSession() {
      loading?.classList.add("hidden");
      testHeader?.classList.remove("hidden");
      questionContainer?.classList.remove("hidden");
      startTime = Date.now();
      runTimer();
      renderQuestion();
    }

    function runTimer() {
      const tick = () => {
        const m = Math.floor(timeRemaining / 60);
        const s = timeRemaining % 60;
        timer.textContent = `${m.toString().padStart(2, "0")}:${s.toString().padStart(2, "0")}`;
        if (timeRemaining <= 300) timer.classList.add("text-red-500");
        if (timeRemaining <= 0) concludeTest();
        timeRemaining--;
      };
      tick();
      timerInterval = setInterval(tick, 1000);
    }

    function renderQuestion() {
      const q = questions[currentQuestionIndex];
      if (!q) return;

      currentQuestionNumber.textContent = (currentQuestionIndex + 1).toString();
      questionIdSpan.textContent = q.id;
      questionTextContainer.textContent = q.texto_pregunta;
      answerOptionsContainer.innerHTML = "";

      q.respuestas.forEach((ans, idx) => {
        const btn = document.createElement("button");
        const isSelected = answers[q.id] === idx;
        btn.className = `group w-full flex items-center p-6 rounded-2xl border-2 text-left transition-all duration-300 ${isSelected ? "border-blue-600 bg-blue-50 dark:bg-blue-900/20" : "border-gray-100 dark:border-gray-700 hover:border-gray-200 dark:hover:border-gray-600 bg-white dark:bg-gray-800"}`;
        btn.innerHTML = `
        <div class="flex-shrink-0 w-8 h-8 rounded-lg flex items-center justify-center font-black text-xs transition-colors ${isSelected ? "bg-blue-600 text-white" : "bg-gray-100 dark:bg-gray-700 text-gray-400 group-hover:bg-gray-200 dark:group-hover:bg-gray-600"}">${String.fromCharCode(65 + idx)}</div>
        <span class="ml-5 font-bold text-gray-700 dark:text-gray-300">${ans.texto_respuesta}</span>
      `;
        btn.onclick = () => {
          answers[q.id] = idx;
          renderQuestion();
        };
        answerOptionsContainer.appendChild(btn);
      });

      prevButton.style.opacity = currentQuestionIndex === 0 ? "0" : "1";
      if (currentQuestionIndex === questions.length - 1) {
        nextButton.classList.add("hidden");
        finishButton.classList.remove("hidden");
      } else {
        nextButton.classList.remove("hidden");
        finishButton.classList.add("hidden");
      }

      const prog = ((currentQuestionIndex + 1) / questions.length) * 100;
      progressBar.style.width = `${prog}%`;
      progressText.textContent = `${Math.round(prog)}%`;
    }

    async function concludeTest() {
      clearInterval(timerInterval);
      loading?.classList.remove("hidden");
      questionContainer?.classList.add("hidden");
      testHeader?.classList.add("hidden");

      try {
        const payload = {
          examen_id: parseInt(EXAM_ID),
          fecha_inicio: new Date(startTime).toISOString(),
          duracion_segundos: Math.floor((Date.now() - startTime) / 1000),
          respuestas: questions
            .map((q) => ({
              pregunta_id: q.id,
              respuesta_id:
                answers[q.id] !== undefined
                  ? q.respuestas[answers[q.id]].id
                  : null,
            }))
            .filter((r) => r.respuesta_id !== null),
        };
        const res = await fetch(`${API_BASE}/validar-respuestas`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        });
        const result = await res.json();

        loading?.classList.add("hidden");
        resultsContainer?.classList.remove("hidden");
        renderResults(result);
      } catch (e) {
        console.error(e);
        showError("Fallo crítico en la validación.");
      }
    }

    function renderResults(data) {
      const timeUsed = Date.now() - startTime;
      const m = Math.floor(timeUsed / 60000);
      const s = Math.floor((timeUsed % 60000) / 1000);

      resultsSummary.innerHTML = `
        <div class="p-10 lg:p-16 text-center bg-gradient-to-b ${data.aprobado ? "from-green-50 to-white dark:from-green-950/20 dark:to-gray-800" : "from-red-50 to-white dark:from-red-950/20 dark:to-gray-800"}">
            <div class="inline-flex p-4 rounded-3xl ${data.aprobado ? "bg-green-100 text-green-600" : "bg-red-100 text-red-600"} mb-8">
                <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="${data.aprobado ? "M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" : "M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.268 17c-.77 1.333.192 3 1.732 3z"}"/></svg>
            </div>
            <h2 class="text-4xl lg:text-5xl font-black text-gray-900 dark:text-white mb-4 tracking-tighter uppercase">${data.aprobado ? "Apto Certificado" : "No Superado"}</h2>
            <p class="text-gray-500 font-bold max-w-sm mx-auto mb-12">${data.aprobado ? "Has cumplido con los estándares requeridos para esta evaluación." : "Se requiere una revisión exhaustiva de los conceptos fallados."}</p>
            
            <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 max-w-3xl mx-auto">
                <div class="p-6 bg-white dark:bg-gray-900 rounded-3xl border border-gray-100 dark:border-gray-700 shadow-sm">
                    <div class="text-[10px] font-black text-gray-400 uppercase tracking-widest mb-1">Puntuación</div>
                    <div class="text-3xl font-black text-blue-600">${data.porcentaje}%</div>
                </div>
                <div class="p-6 bg-white dark:bg-gray-900 rounded-3xl border border-gray-100 dark:border-gray-700 shadow-sm">
                    <div class="text-[10px] font-black text-gray-400 uppercase tracking-widest mb-1">Aciertos</div>
                    <div class="text-3xl font-black text-green-600">${data.correctas}</div>
                </div>
                <div class="p-6 bg-white dark:bg-gray-900 rounded-3xl border border-gray-100 dark:border-gray-700 shadow-sm">
                    <div class="text-[10px] font-black text-gray-400 uppercase tracking-widest mb-1">Fallos</div>
                    <div class="text-3xl font-black text-red-600">${data.total_preguntas - data.correctas}</div>
                </div>
                <div class="p-6 bg-white dark:bg-gray-900 rounded-3xl border border-gray-100 dark:border-gray-700 shadow-sm">
                    <div class="text-[10px] font-black text-gray-400 uppercase tracking-widest mb-1">Tiempo</div>
                    <div class="text-2xl font-black text-gray-900 dark:text-white">${m}:${s.toString().padStart(2, "0")}</div>
                </div>
            </div>
        </div>

        <div class="p-8 lg:p-12 space-y-8">
            <h3 class="text-xs font-black text-gray-400 uppercase tracking-widest flex items-center"><svg class="w-4 h-4 mr-2 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>Desglose Analítico</h3>
            <div class="grid gap-6">
                ${data.resultados
                  .map((res, i) => {
                    const q = questions.find(
                      (item) => item.id === res.pregunta_id,
                    );
                    return `
                        <div class="group relative p-6 rounded-3xl border ${res.es_correcta ? "border-green-100 bg-green-50/20 dark:border-green-900/30" : "border-red-100 bg-red-50/20 dark:border-red-900/30"} transition-all">
                            <div class="flex justify-between items-start mb-4">
                                <span class="text-[10px] font-black ${res.es_correcta ? "text-green-600" : "text-red-600"} uppercase tracking-widest">Pregunta ${i + 1} — ${res.es_correcta ? "Correcta" : "Error"}</span>
                            </div>
                            <p class="text-lg font-bold text-gray-800 dark:text-gray-200 mb-6 leading-snug">${q ? q.texto_pregunta : "Cargando texto de la pregunta..."}</p>
                            ${res.explicacion ? `<div class="p-4 bg-white dark:bg-gray-900/50 rounded-2xl text-xs font-medium text-gray-500 dark:text-gray-400 border border-gray-50 dark:border-gray-700 leading-relaxed"><span class="block text-[8px] font-black uppercase tracking-tighter text-blue-500 mb-1">Análisis técnico</span>${res.explicacion}</div>` : ""}
                        </div>
                    `;
                  })
                  .join("")}
            </div>
        </div>
    `;
    }

    function showError(msg) {
      loading.innerHTML = `<div class="p-20 text-center"><div class="text-red-500 font-black uppercase tracking-widest mb-4">ERROR DE SISTEMA</div><div class="text-gray-500 font-bold mb-8">${msg}</div><button onclick="window.location.href='/tests/'" class="px-8 py-3 bg-gray-900 text-white rounded-2xl font-black text-xs uppercase tracking-widest">Reintentar</button></div>`;
    }
  </script>
</MainLayout>

<!-- Custom Scrollbar Styles -->
<style>
  /* Custom scrollbar for detailed results */
  .custom-scrollbar {
    scrollbar-width: thin;
    scrollbar-color: #3b82f6 #f1f5f9;
  }

  .custom-scrollbar::-webkit-scrollbar {
    width: 6px;
  }

  .custom-scrollbar::-webkit-scrollbar-track {
    background: #f1f5f9;
    border-radius: 10px;
  }

  .dark .custom-scrollbar::-webkit-scrollbar-track {
    background: #1e293b;
  }

  .custom-scrollbar::-webkit-scrollbar-thumb {
    background: linear-gradient(135deg, #3b82f6, #06b6d4);
    border-radius: 10px;
    transition: all 0.3s ease;
  }

  .custom-scrollbar::-webkit-scrollbar-thumb:hover {
    background: linear-gradient(135deg, #2563eb, #0891b2);
    transform: scale(1.1);
  }

  .dark .custom-scrollbar::-webkit-scrollbar-thumb {
    background: linear-gradient(135deg, #60a5fa, #22d3ee);
  }

  .dark .custom-scrollbar::-webkit-scrollbar-thumb:hover {
    background: linear-gradient(135deg, #3b82f6, #06b6d4);
  }
</style>
