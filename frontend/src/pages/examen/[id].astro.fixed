---
import MainLayout from '../../layouts/MainLayout.astro';

// Generate static paths for all available exam IDs
export async function getStaticPaths() {
  // CORRECCIÓN: Generar paths usando datos reales de la base de datos
  // En lugar de generar IDs fijos 1-27, obtener IDs reales de exámenes
  try {
    const API_BASE = 'http://localhost:8000/api';
    const response = await fetch(`${API_BASE}/examenes`);
    
    if (response.ok) {
      const examenes = await response.json();
      return examenes.map(examen => ({
        params: { id: examen.id.toString() }
      }));
    }
  } catch (error) {
    console.error('Error fetching exams for static paths:', error);
  }
  
  // FALLBACK: Si falla la consulta a la API, generar IDs comunes
  const paths = [];
  for (let i = 1; i <= 50; i++) {
    paths.push({ params: { id: i.toString() } });
  }
  return paths;
}

// CORRECCIÓN: Validar que el ID existe antes de continuar
const { id } = Astro.params;

// Validar que el ID es numérico y válido
if (!id || isNaN(Number(id))) {
  // REDIRECCIÓN CORREGIDA: En lugar de redirigir a index, ir a página de tests
  return Astro.redirect('/tests/');
}

// MEJORA: Verificar que el examen existe en la base de datos
let examExists = false;
try {
  const API_BASE = 'http://localhost:8000/api';
  const response = await fetch(`${API_BASE}/examenes/${id}`);
  examExists = response.ok;
} catch (error) {
  console.error('Error checking exam existence:', error);
}

// Si el examen no existe, redirigir a tests
if (!examExists) {
  return Astro.redirect('/tests/');
}
