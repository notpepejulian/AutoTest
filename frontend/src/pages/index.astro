---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout
    title="AutoTest - Certificación Vial Profesional"
    description="Plataforma líder para la preparación del examen teórico de conducir. Métricas avanzadas, banco de preguntas oficial y análisis técnico de rendimiento."
>
    <!-- Hero Section -->
    <section class="relative text-center py-20 lg:py-32 mb-16 overflow-hidden">
        <div
            class="absolute inset-0 -z-10 bg-[radial-gradient(#e5e7eb_1px,transparent_1px)] dark:bg-[radial-gradient(#1f2937_1px,transparent_1px)] [background-size:40px_40px] [mask-image:radial-gradient(ellipse_50%_50%_at_50%_50%,#000_70%,transparent_100%)] opacity-20"
        >
        </div>
        <div class="absolute inset-0 -z-10 overflow-hidden">
            <div
                class="absolute -top-[10%] left-1/2 -translate-x-1/2 w-[600px] h-[600px] bg-blue-400/20 dark:bg-blue-600/10 rounded-full filter blur-[120px] animate-pulse"
            >
            </div>
            <div
                class="absolute top-1/4 -left-1/4 w-96 h-96 bg-cyan-400/20 dark:bg-cyan-600/10 rounded-full filter blur-[100px] animate-blob"
            >
            </div>
            <div
                class="absolute bottom-1/4 -right-1/4 w-96 h-96 bg-blue-400/20 dark:bg-blue-600/10 rounded-full filter blur-[100px] animate-blob animation-delay-4000"
            >
            </div>
        </div>

        <div
            class="inline-flex items-center px-5 py-2.5 rounded-full bg-blue-50 dark:bg-blue-900/20 text-blue-700 dark:text-blue-300 text-xs font-black uppercase tracking-widest mb-10 border border-blue-100 dark:border-blue-800/30"
        >
            Sistemas de Evaluación Homologados
        </div>

        <h1
            class="text-4xl sm:text-6xl lg:text-8xl font-black mb-8 leading-tight tracking-tighter"
        >
            <span class="text-gray-900 dark:text-white">Excelencia en</span>
            <br />
            <span
                class="bg-gradient-to-r from-blue-600 to-cyan-500 bg-clip-text text-transparent"
            >
                Formación Vial
            </span>
        </h1>

        <p
            class="text-base sm:text-xl text-gray-500 dark:text-gray-400 mb-14 max-w-2xl mx-auto font-medium leading-relaxed"
        >
            Plataforma técnica de alto rendimiento diseñada para profesionales.
            Algoritmos de aprendizaje adaptativo y analítica en tiempo real.
        </p>

        <div
            class="flex flex-col sm:flex-row gap-6 justify-center items-center"
        >
            <a
                href="/tests/"
                class="group relative inline-flex items-center px-10 py-5 bg-gray-900 dark:bg-white text-white dark:text-gray-900 rounded-2xl transition-all duration-300 font-bold text-lg shadow-2xl hover:scale-105 active:scale-95 overflow-hidden"
            >
                <span class="relative z-10 flex items-center">
                    COMENZAR
                    <svg
                        class="w-5 h-5 ml-3 group-hover:translate-x-1 transition-transform"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                        ><path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2.5"
                            d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg
                    >
                </span>
            </a>
            <a
                href="/nosotros/"
                class="inline-flex items-center px-10 py-5 bg-white dark:bg-gray-800/50 text-gray-900 dark:text-white rounded-2xl border border-gray-100 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-800 transition-all font-bold text-lg"
            >
                Saber Más
            </a>
        </div>
    </section>

    <!-- Estadísticas -->
    <section id="features" class="py-24 bg-white dark:bg-gray-950">
        <div class="container mx-auto px-6 text-center">
            <div class="max-w-3xl mx-auto mb-20 text-center">
                <h2
                    class="text-4xl lg:text-5xl font-black text-gray-900 dark:text-white mb-6 tracking-tighter uppercase"
                >
                    Características <span class="text-blue-600"
                        >Principales</span>
                </h2>
                <p
                    class="text-gray-500 dark:text-gray-400 font-medium text-lg leading-relaxed"
                >
                    Tecnología de vanguardia diseñada para maximizar tu
                    rendimiento y garantizar resultados excepcionales en tu
                    formación vial.
                </p>
            </div>

            <div class="grid md:grid-cols-3 gap-8">
                <div
                    class="group p-10 bg-gray-50 dark:bg-gray-900 rounded-[2.5rem] border border-gray-100 dark:border-gray-800 hover:border-blue-500/30 transition-all duration-500"
                >
                    <div
                        class="w-16 h-16 bg-blue-600 rounded-2xl flex items-center justify-center text-white mb-8 shadow-xl shadow-blue-600/20 group-hover:scale-110 transition-transform mx-auto"
                    >
                        <svg
                            class="w-8 h-8"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                            ><path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg
                        >
                    </div>
                    <h3
                        class="text-xl font-bold text-gray-900 dark:text-white mb-4 uppercase tracking-tight"
                    >
                        IA Adaptativa
                    </h3>
                    <p
                        class="text-gray-500 dark:text-gray-400 leading-relaxed font-medium"
                    >
                        Algoritmos que identifican tus puntos débiles y
                        refuerzan el aprendizaje de manera inteligente.
                    </p>
                </div>

                <div
                    class="group p-10 bg-gray-50 dark:bg-gray-900 rounded-[2.5rem] border border-gray-100 dark:border-gray-800 hover:border-indigo-500/30 transition-all duration-500"
                >
                    <div
                        class="w-16 h-16 bg-indigo-600 rounded-2xl flex items-center justify-center text-white mb-8 shadow-xl shadow-indigo-600/20 group-hover:scale-110 transition-transform mx-auto"
                    >
                        <svg
                            class="w-8 h-8"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                            ><path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
                            ></path></svg
                        >
                    </div>
                    <h3
                        class="text-xl font-bold text-gray-900 dark:text-white mb-4 uppercase tracking-tight"
                    >
                        Simulación HQ
                    </h3>
                    <p
                        class="text-gray-500 dark:text-gray-400 leading-relaxed font-medium"
                    >
                        Interfaz de examen idéntica a la oficial para reducir la
                        ansiedad y mejorar la familiaridad.
                    </p>
                </div>

                <div
                    class="group p-10 bg-gray-50 dark:bg-gray-900 rounded-[2.5rem] border border-gray-100 dark:border-gray-800 hover:border-cyan-500/30 transition-all duration-500"
                >
                    <div
                        class="w-16 h-16 bg-cyan-600 rounded-2xl flex items-center justify-center text-white mb-8 shadow-xl shadow-cyan-600/20 group-hover:scale-110 transition-transform mx-auto"
                    >
                        <svg
                            class="w-8 h-8"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                            ><path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"
                            ></path></svg
                        >
                    </div>
                    <h3
                        class="text-xl font-bold text-gray-900 dark:text-white mb-4 uppercase tracking-tight"
                    >
                        Analítica Pro
                    </h3>
                    <p
                        class="text-gray-500 dark:text-gray-400 leading-relaxed font-medium"
                    >
                        Métricas detalladas de tu progreso con predicción de
                        éxito basada en datos históricos.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- Stats Section -->
    <section
        class="py-24 bg-gray-50/50 dark:bg-gray-900/50 border-y border-gray-100 dark:border-gray-800 text-center"
    >
        <div class="container mx-auto px-6">
            <div
                class="max-w-4xl mx-auto grid grid-cols-2 md:grid-cols-4 gap-8 md:gap-12"
            >
                <div>
                    <div
                        class="text-4xl lg:text-5xl font-black text-gray-900 dark:text-white mb-2 tracking-tighter"
                    >
                        98%
                    </div>
                    <div
                        class="text-[10px] font-black text-blue-600 uppercase tracking-[0.2em]"
                    >
                        Éxito Real
                    </div>
                </div>
                <div>
                    <div
                        class="text-4xl lg:text-5xl font-black text-gray-900 dark:text-white mb-2 tracking-tighter"
                    >
                        +5k
                    </div>
                    <div
                        class="text-[10px] font-black text-blue-600 uppercase tracking-[0.2em]"
                    >
                        Candidatos
                    </div>
                </div>
                <div>
                    <div
                        class="text-4xl lg:text-5xl font-black text-gray-900 dark:text-white mb-2 tracking-tighter"
                    >
                        24/7
                    </div>
                    <div
                        class="text-[10px] font-black text-blue-600 uppercase tracking-[0.2em]"
                    >
                        Soporte AI
                    </div>
                </div>
                <div>
                    <div
                        class="text-4xl lg:text-5xl font-black text-gray-900 dark:text-white mb-2 tracking-tighter"
                    >
                        +30k
                    </div>
                    <div
                        class="text-[10px] font-black text-blue-600 uppercase tracking-[0.2em]"
                    >
                        Tests HQ
                    </div>
                </div>
            </div>
        </div>
    </section>
</MainLayout>
