---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="AutoTest - Tests de Autoescuela Online" description="Plataforma líder para la preparación del examen teórico de conducir. Miles de preguntas actualizadas, tests personalizados y análisis detallado.">
    <!-- Hero Section -->
    <section class="text-center py-16 mb-16">
        <div class="inline-flex items-center px-4 py-2 rounded-full bg-blue-100 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400 text-sm font-medium mb-6">
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
            </svg>
            🚗 Tests de Autoescuela Online
        </div>
        
        <h1 class="text-5xl lg:text-7xl font-bold mb-6">
            <span class="bg-gradient-to-r from-blue-600 to-cyan-500 bg-clip-text text-transparent">
                Prepárate para
            </span>
            <br>
            <span class="bg-gradient-to-r from-gray-900 to-gray-600 dark:from-white dark:to-gray-300 bg-clip-text text-transparent">
                tu Examen
            </span>
        </h1>
        
        <p class="text-xl text-gray-600 dark:text-gray-400 mb-10 max-w-3xl mx-auto leading-relaxed">
            La plataforma más completa para preparar el examen teórico de conducir. Miles de preguntas actualizadas, 
            tests personalizados y análisis detallado de tu progreso.
        </p>
        
        <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
            <a href="http://localhost:4321/tests/" class="inline-flex items-center px-8 py-4 bg-gradient-to-r from-blue-600 to-cyan-500 text-white rounded-xl hover:from-blue-700 hover:to-cyan-600 transition-all duration-200 font-semibold text-lg shadow-lg hover:shadow-xl transform hover:-translate-y-1">
                <svg class="w-6 h-6 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                </svg>
                Comenzar Tests
            </a>
            <a href="http://localhost:4321/nosotros/" class="inline-flex items-center px-8 py-4 bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 rounded-xl hover:bg-gray-200 dark:hover:bg-gray-700 transition-all duration-200 font-semibold text-lg">
                <svg class="w-6 h-6 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                Saber Más
            </a>
        </div>
    </section>
    
    <!-- Estadísticas -->
    <section class="py-16 bg-gradient-to-r from-blue-600 to-cyan-500 rounded-2xl text-white text-center mb-16">
        <h2 class="text-3xl font-bold mb-8">AutoTest en Números</h2>
        <div class="grid md:grid-cols-4 gap-8 max-w-4xl mx-auto">
            <div>
                <div class="text-4xl font-bold mb-2">3000+</div>
                <div class="text-blue-100">Preguntas Disponibles</div>
            </div>
            <div>
                <div class="text-4xl font-bold mb-2">5</div>
                <div class="text-blue-100">Categorías Especializadas</div>
            </div>
            <div>
                <div class="text-4xl font-bold mb-2">50+</div>
                <div class="text-blue-100">Tests por Categoría</div>
            </div>
            <div>
                <div class="text-4xl font-bold mb-2">24/7</div>
                <div class="text-blue-100">Disponible Siempre</div>
            </div>
        </div>
    </section>
    
    <!-- Características principales -->
    <section class="mb-16">
        <h2 class="text-3xl font-bold text-center mb-12 text-gray-900 dark:text-white">¿Por qué elegir AutoTest?</h2>
        <div class="grid md:grid-cols-3 gap-8">
            <div class="bg-white/80 dark:bg-gray-800/80 backdrop-blur-sm rounded-2xl p-8 shadow-lg border border-white/20 dark:border-gray-700/50">
                <div class="w-16 h-16 bg-gradient-to-br from-blue-500 to-blue-600 rounded-2xl flex items-center justify-center mb-6">
                    <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                    </svg>
                </div>
                <h3 class="text-2xl font-bold mb-4 text-gray-900 dark:text-white">Resultados Instantáneos</h3>
                <p class="text-gray-600 dark:text-gray-400 leading-relaxed">
                    Obtén corrección inmediata con explicaciones detalladas para cada respuesta. 
                    Aprende de tus errores al momento.
                </p>
            </div>
            
            <div class="bg-white/80 dark:bg-gray-800/80 backdrop-blur-sm rounded-2xl p-8 shadow-lg border border-white/20 dark:border-gray-700/50">
                <div class="w-16 h-16 bg-gradient-to-br from-cyan-500 to-blue-500 rounded-2xl flex items-center justify-center mb-6">
                    <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
                    </svg>
                </div>
                <h3 class="text-2xl font-bold mb-4 text-gray-900 dark:text-white">Análisis Completo</h3>
                <p class="text-gray-600 dark:text-gray-400 leading-relaxed">
                    Seguimiento detallado de tu progreso, áreas de mejora y estadísticas personalizadas 
                    para optimizar tu preparación.
                </p>
            </div>
            
            <div class="bg-white/80 dark:bg-gray-800/80 backdrop-blur-sm rounded-2xl p-8 shadow-lg border border-white/20 dark:border-gray-700/50">
                <div class="w-16 h-16 bg-gradient-to-br from-purple-500 to-pink-600 rounded-2xl flex items-center justify-center mb-6">
                    <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
                    </svg>
                </div>
                <h3 class="text-2xl font-bold mb-4 text-gray-900 dark:text-white">Contenido Actualizado</h3>
                <p class="text-gray-600 dark:text-gray-400 leading-relaxed">
                    Base de datos con las últimas normativas de tráfico españolas. 
                    Preguntas oficiales y actualizaciones constantes.
                </p>
            </div>
        </div>
    </section>
    
    <!-- Cómo funciona -->
    <section class="mb-16">
        <h2 class="text-3xl font-bold text-center mb-12 text-gray-900 dark:text-white">¿Cómo funciona?</h2>
        <div class="max-w-4xl mx-auto">
            <div class="grid md:grid-cols-2 gap-12 items-center">
                <div class="space-y-8">
                    <div class="flex items-start space-x-4">
                        <div class="w-10 h-10 bg-blue-500 text-white rounded-full flex items-center justify-center font-bold flex-shrink-0">
                            1
                        </div>
                        <div>
                            <h4 class="text-xl font-semibold mb-2 text-gray-900 dark:text-white">Elige tu Categoría</h4>
                            <p class="text-gray-600 dark:text-gray-400">
                                Selecciona entre 5 categorías especializadas: Señales, Normativa, Seguridad Vial, Mecánica o Test Completo.
                            </p>
                        </div>
                    </div>
                    
                    <div class="flex items-start space-x-4">
                        <div class="w-10 h-10 bg-cyan-500 text-white rounded-full flex items-center justify-center font-bold flex-shrink-0">
                            2
                        </div>
                        <div>
                            <h4 class="text-xl font-semibold mb-2 text-gray-900 dark:text-white">Realiza el Test</h4>
                            <p class="text-gray-600 dark:text-gray-400">
                                Responde 30 preguntas con temporizador opcional. Cada test es único con preguntas aleatorias.
                            </p>
                        </div>
                    </div>
                    
                    <div class="flex items-start space-x-4">
                        <div class="w-10 h-10 bg-purple-500 text-white rounded-full flex items-center justify-center font-bold flex-shrink-0">
                            3
                        </div>
                        <div>
                            <h4 class="text-xl font-semibold mb-2 text-gray-900 dark:text-white">Analiza Resultados</h4>
                            <p class="text-gray-600 dark:text-gray-400">
                                Revisa tu puntuación, errores cometidos y explicaciones detalladas para mejorar.
                            </p>
                        </div>
                    </div>
                </div>
                
                <div class="bg-gradient-to-br from-blue-50 to-cyan-50 dark:from-gray-800 dark:to-gray-700 rounded-2xl p-8">
                    <div class="text-center">
                        <div class="w-24 h-24 bg-gradient-to-br from-blue-500 to-cyan-500 rounded-2xl flex items-center justify-center mx-auto mb-6">
                            <svg class="w-12 h-12 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
                            </svg>
                        </div>
                        <h4 class="text-2xl font-bold mb-4 text-gray-900 dark:text-white">¡Empieza Ahora!</h4>
                        <p class="text-gray-600 dark:text-gray-400 mb-6">
                            Miles de estudiantes ya confían en AutoTest para preparar su examen teórico.
                        </p>
                        <a href="http://localhost:4321/tests/" class="inline-flex items-center px-6 py-3 bg-gradient-to-r from-blue-600 to-cyan-500 text-white rounded-xl hover:from-blue-700 hover:to-cyan-600 transition-all duration-200 font-semibold">
                            Acceder a Tests
                            <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5-5 5M6 12h12"></path>
                            </svg>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>
    
    <!-- Enlaces rápidos -->
    <section class="mb-16">
        <h2 class="text-3xl font-bold text-center mb-12 text-gray-900 dark:text-white">Explora AutoTest</h2>
        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
            <a href="http://localhost:4321/tests/" class="group bg-white/80 dark:bg-gray-800/80 backdrop-blur-sm rounded-xl p-6 shadow-lg border border-white/20 dark:border-gray-700/50 hover:shadow-xl transition-all duration-300 hover:-translate-y-1">
                <div class="w-12 h-12 bg-gradient-to-br from-blue-500 to-blue-600 rounded-xl flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
                    <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
                    </svg>
                </div>
                <h4 class="text-lg font-semibold mb-2 text-gray-900 dark:text-white group-hover:text-blue-600 transition-colors">Tests Online</h4>
                <p class="text-gray-600 dark:text-gray-400 text-sm">Accede a todos nuestros tests organizados por categorías</p>
            </a>
            
            <a href="http://localhost:4321/videos/" class="group bg-white/80 dark:bg-gray-800/80 backdrop-blur-sm rounded-xl p-6 shadow-lg border border-white/20 dark:border-gray-700/50 hover:shadow-xl transition-all duration-300 hover:-translate-y-1">
                <div class="w-12 h-12 bg-gradient-to-br from-purple-500 to-pink-600 rounded-xl flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
                    <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
                    </svg>
                </div>
                <h4 class="text-lg font-semibold mb-2 text-gray-900 dark:text-white group-hover:text-purple-600 transition-colors">Videos Explicativos</h4>
                <p class="text-gray-600 dark:text-gray-400 text-sm">Aprende con contenido audiovisual especializado</p>
            </a>
            
            <a href="http://localhost:4321/nosotros/" class="group bg-white/80 dark:bg-gray-800/80 backdrop-blur-sm rounded-xl p-6 shadow-lg border border-white/20 dark:border-gray-700/50 hover:shadow-xl transition-all duration-300 hover:-translate-y-1">
                <div class="w-12 h-12 bg-gradient-to-br from-green-500 to-emerald-600 rounded-xl flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
                    <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
                    </svg>
                </div>
                <h4 class="text-lg font-semibold mb-2 text-gray-900 dark:text-white group-hover:text-green-600 transition-colors">Sobre Nosotros</h4>
                <p class="text-gray-600 dark:text-gray-400 text-sm">Conoce más sobre nuestro equipo y misión</p>
            </a>
            
            <a href="http://localhost:4321/chatbot/" class="group bg-white/80 dark:bg-gray-800/80 backdrop-blur-sm rounded-xl p-6 shadow-lg border border-white/20 dark:border-gray-700/50 hover:shadow-xl transition-all duration-300 hover:-translate-y-1">
                <div class="w-12 h-12 bg-gradient-to-br from-cyan-500 to-blue-500 rounded-xl flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
                    <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
                    </svg>
                </div>
                <div class="flex items-center mb-2">
                    <h4 class="text-lg font-semibold text-gray-900 dark:text-white group-hover:text-cyan-600 transition-colors">Chatbot IA</h4>
                    <span class="ml-2 px-2 py-1 bg-cyan-100 dark:bg-cyan-900/30 text-cyan-600 dark:text-cyan-400 rounded-full text-xs font-medium">Beta</span>
                </div>
                <p class="text-gray-600 dark:text-gray-400 text-sm">Asistente virtual para resolver tus dudas</p>
            </a>
        </div>
    </section>

</MainLayout>
