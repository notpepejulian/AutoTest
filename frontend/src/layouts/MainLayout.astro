          <div class="pt-8 px-4">
            {
              user ? (
                <div class="flex items-center justify-between p-4 bg-gray-50 dark:bg-gray-900 rounded-2xl">
                  <div>
                    <p class="text-xs font-black text-gray-900 dark:text-white uppercase tracking-tighter">
                      {(user as any).username}
