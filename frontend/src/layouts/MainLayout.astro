                    <p class="text-[8px] font-bold text-blue-500 uppercase">
                      Cuenta Activa
                    </p>
                  </div>
                  <button
                    id="logout-button-mobile"
                    class="px-4 py-2 bg-red-500/10 text-red-500 text-[10px] font-black uppercase tracking-widest rounded-xl"
                  >
                    Salir
                  </button>
                </div>
              ) : (
                <a href="/auth">
                  <button class="w-full py-4 bg-blue-600 hover:bg-blue-700 text-white rounded-2xl shadow-xl shadow-blue-600/20 font-black text-xs uppercase tracking-[0.2em] transition-all">
                    Identificarse
                  </button>
                </a>
              )
            }
          </div>

          <div class="flex justify-center pt-8">
            <button
              id="theme-toggle-mobile"
              class="flex items-center space-x-3 px-6 py-3 bg-gray-100 dark:bg-gray-800 rounded-full text-xs font-black uppercase tracking-widest text-gray-600 dark:text-gray-300"
            >
              <svg
                class="w-4 h-4"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2.5"
                  d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
                ></path>
              </svg>
              <span>Alternar Tema</span>
            </button>
          </div>
        </div>
